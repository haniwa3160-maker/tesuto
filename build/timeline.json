{
 "total": 252.095,
 "fps": 24,
 "events": [
  {
   "kind": "hold",
   "scene": "s1",
   "start": 0.0,
   "end": 2.4,
   "sub": null
  },
  {
   "kind": "line",
   "scene": "s1",
   "speaker": "N",
   "start": 2.4,
   "end": 7.473,
   "sub": "ハナは きのう\nこの だんちに ひっこして きました。"
  },
  {
   "kind": "line",
   "scene": "s1",
   "speaker": "N",
   "start": 8.023,
   "end": 12.625,
   "sub": "まどから 見えるのは\nコンクリートの なかにわ だけ。"
  },
  {
   "kind": "hold",
   "scene": "s1",
   "start": 13.175,
   "end": 14.775,
   "sub": null
  },
  {
   "kind": "line",
   "scene": "s1",
   "speaker": "hana",
   "start": 14.775,
   "end": 16.589,
   "sub": "……ともだち、できるかな。"
  },
  {
   "kind": "line",
   "scene": "s2",
   "speaker": "N",
   "start": 17.789,
   "end": 25.047,
   "sub": "そだいごみの おきばで\nハナは 白い ロボットの 犬を 見つけました。"
  },
  {
   "kind": "hold",
   "scene": "s2",
   "start": 25.597,
   "end": 27.397,
   "sub": null
  },
  {
   "kind": "line",
   "scene": "s2",
   "speaker": "hana",
   "start": 27.397,
   "end": 30.102,
   "sub": "……こんな ところで、ひとりぼっち？"
  },
  {
   "kind": "line",
   "scene": "s2",
   "speaker": "N",
   "start": 30.652,
   "end": 34.744,
   "sub": "ハナは その子を\nそっと だきあげました。"
  },
  {
   "kind": "line",
   "scene": "s3",
   "speaker": "N",
   "start": 35.744,
   "end": 38.51,
   "sub": "ふいて、みがいて、じゅうでんして。"
  },
  {
   "kind": "line",
   "scene": "s3",
   "speaker": "N",
   "start": 39.06,
   "end": 44.948,
   "sub": "その よる ハナは\nずっと ドライバーを にぎって いました。"
  },
  {
   "kind": "hold",
   "scene": "s3",
   "start": 45.498,
   "end": 47.698,
   "sub": null
  },
  {
   "kind": "line",
   "scene": "s3",
   "speaker": "N",
   "start": 47.698,
   "end": 48.88,
   "sub": "あさ。ピピッ。"
  },
  {
   "kind": "line",
   "scene": "s3",
   "speaker": "hana",
   "start": 49.78,
   "end": 53.245,
   "sub": "うごいた……！\nきみ、きょうから シロだよ！"
  },
  {
   "kind": "line",
   "scene": "s4",
   "speaker": "N",
   "start": 54.545,
   "end": 62.258,
   "sub": "つぎの日。シロは なかにわの\nひびわれの そばで いきなり ほりはじめました。"
  },
  {
   "kind": "hold",
   "scene": "s4",
   "start": 62.808,
   "end": 64.408,
   "sub": null
  },
  {
   "kind": "line",
   "scene": "s4",
   "speaker": "N",
   "start": 64.408,
   "end": 69.18,
   "sub": "ほって みると 出てきたのは\nふるい かんかん。"
  },
  {
   "kind": "line",
   "scene": "s4",
   "speaker": "N",
   "start": 69.73,
   "end": 75.832,
   "sub": "中には しゃしんと てがみと\n小さな たねが ひとつぶ。"
  },
  {
   "kind": "hold",
   "scene": "s4",
   "start": 76.382,
   "end": 77.782,
   "sub": null
  },
  {
   "kind": "line",
   "scene": "s4",
   "speaker": "baa",
   "start": 77.782,
   "end": 82.65,
   "sub": "あらまあ。ごじゅうねん まえに\nみんなで うめたんだよ。"
  },
  {
   "kind": "line",
   "scene": "s4",
   "speaker": "baa",
   "start": 83.2,
   "end": 89.273,
   "sub": "「いつか ここを 花で いっぱいに」\nって ね。"
  },
  {
   "kind": "line",
   "scene": "s4",
   "speaker": "hana",
   "start": 89.823,
   "end": 91.056,
   "sub": "……やって みる。"
  },
  {
   "kind": "line",
   "scene": "s5",
   "speaker": "N",
   "start": 92.256,
   "end": 97.866,
   "sub": "そこへ となりの とうの\nケンタが やって きました。"
  },
  {
   "kind": "line",
   "scene": "s5",
   "speaker": "kenta",
   "start": 98.416,
   "end": 103.07,
   "sub": "その ロボット おれにも かして。\nぜったい バズるって！"
  },
  {
   "kind": "line",
   "scene": "s5",
   "speaker": "N",
   "start": 103.62,
   "end": 111.064,
   "sub": "ケンタは さいきん どうがの\nさいせいすうが のびなくて あせって いました。"
  },
  {
   "kind": "line",
   "scene": "s5",
   "speaker": "hana",
   "start": 111.614,
   "end": 113.26,
   "sub": "……やさしく、してね。"
  },
  {
   "kind": "line",
   "scene": "s6",
   "speaker": "N",
   "start": 114.26,
   "end": 120.986,
   "sub": "けれど ほっても ほっても\n出てくるのは あきかんと レジぶくろ ばかり。"
  },
  {
   "kind": "line",
   "scene": "s6",
   "speaker": "kenta",
   "start": 121.536,
   "end": 126.476,
   "sub": "ちがう こんなんじゃ ない！\nもっと おたから ほれって！"
  },
  {
   "kind": "hold",
   "scene": "s6",
   "start": 127.026,
   "end": 128.026,
   "sub": null
  },
  {
   "kind": "line",
   "scene": "s6",
   "speaker": "N",
   "start": 128.026,
   "end": 128.501,
   "sub": "ガシャン。"
  },
  {
   "kind": "line",
   "scene": "s6",
   "speaker": "N",
   "start": 129.901,
   "end": 134.481,
   "sub": "シロの 目の ひかりが\nすうっと きえました。"
  },
  {
   "kind": "line",
   "scene": "s6",
   "speaker": "kenta",
   "start": 135.031,
   "end": 135.283,
   "sub": "……あ。"
  },
  {
   "kind": "line",
   "scene": "s7",
   "speaker": "N",
   "start": 136.883,
   "end": 140.008,
   "sub": "ふいても、みがいても、じゅうでんしても。"
  },
  {
   "kind": "hold",
   "scene": "s7",
   "start": 140.558,
   "end": 142.558,
   "sub": null
  },
  {
   "kind": "line",
   "scene": "s7",
   "speaker": "N",
   "start": 142.558,
   "end": 146.459,
   "sub": "シロは もう\nワンとは いいませんでした。"
  },
  {
   "kind": "hold",
   "scene": "s7",
   "start": 147.009,
   "end": 148.809,
   "sub": null
  },
  {
   "kind": "line",
   "scene": "s7",
   "speaker": "hana",
   "start": 148.809,
   "end": 151.788,
   "sub": "……ごめんね。\nもっと あそびたかったね。"
  },
  {
   "kind": "line",
   "scene": "s8",
   "speaker": "N",
   "start": 153.588,
   "end": 162.012,
   "sub": "その とき。ハナは シロの おなかが\nすこし ひらいて いる ことに 気づきました。"
  },
  {
   "kind": "hold",
   "scene": "s8",
   "start": 162.562,
   "end": 164.162,
   "sub": null
  },
  {
   "kind": "line",
   "scene": "s8",
   "speaker": "N",
   "start": 164.162,
   "end": 167.74,
   "sub": "中には つちと たねが いっぱい。"
  },
  {
   "kind": "line",
   "scene": "s8",
   "speaker": "N",
   "start": 168.29,
   "end": 172.324,
   "sub": "シロは ほって いたんじゃ\nありませんでした。"
  },
  {
   "kind": "line",
   "scene": "s8",
   "speaker": "N",
   "start": 172.874,
   "end": 176.955,
   "sub": "まいにち すこしずつ\nうめて いたのです。"
  },
  {
   "kind": "line",
   "scene": "s8",
   "speaker": "baa",
   "start": 177.955,
   "end": 182.18,
   "sub": "ごじゅうねん\nずっと まって いたんだねえ。"
  },
  {
   "kind": "line",
   "scene": "s9",
   "speaker": "N",
   "start": 183.58,
   "end": 185.082,
   "sub": "ふゆが すぎて。"
  },
  {
   "kind": "line",
   "scene": "s9",
   "speaker": "N",
   "start": 186.482,
   "end": 188.037,
   "sub": "はるが きました。"
  },
  {
   "kind": "line",
   "scene": "s9",
   "speaker": "N",
   "start": 189.637,
   "end": 193.387,
   "sub": "ひびわれから、めが。\nめから、つぼみが。"
  },
  {
   "kind": "line",
   "scene": "s9",
   "speaker": "N",
   "start": 193.937,
   "end": 194.783,
   "sub": "つぼみから――"
  },
  {
   "kind": "line",
   "scene": "s9",
   "speaker": "all",
   "start": 196.283,
   "end": 196.834,
   "sub": "わあああ！"
  },
  {
   "kind": "line",
   "scene": "s9",
   "speaker": "N",
   "start": 198.034,
   "end": 203.32,
   "sub": "はいいろ だった なかにわは\n花で いっぱいに なりました。"
  },
  {
   "kind": "line",
   "scene": "s10",
   "speaker": "N",
   "start": 204.92,
   "end": 212.763,
   "sub": "花の はしっこに ケンタが\n立って いました。スマホは もって いません。"
  },
  {
   "kind": "line",
   "scene": "s10",
   "speaker": "kenta",
   "start": 213.313,
   "end": 216.113,
   "sub": "……あの。ごめん。\nこわして、ごめん。"
  },
  {
   "kind": "hold",
   "scene": "s10",
   "start": 216.663,
   "end": 217.863,
   "sub": null
  },
  {
   "kind": "line",
   "scene": "s10",
   "speaker": "hana",
   "start": 217.863,
   "end": 220.402,
   "sub": "じゃあ、みずやり てつだって。"
  },
  {
   "kind": "line",
   "scene": "s10",
   "speaker": "kenta",
   "start": 220.952,
   "end": 221.788,
   "sub": "……えっ。……うん。"
  },
  {
   "kind": "line",
   "scene": "s10",
   "speaker": "N",
   "start": 222.988,
   "end": 227.293,
   "sub": "ケンタの どうがは\nだれにも 見られませんでした。"
  },
  {
   "kind": "line",
   "scene": "s10",
   "speaker": "N",
   "start": 227.843,
   "end": 233.711,
   "sub": "でも この なかにわには\nまいにち 人が あつまります。"
  },
  {
   "kind": "line",
   "scene": "end",
   "speaker": "N",
   "start": 234.911,
   "end": 240.526,
   "sub": "ほんとうに ほしい ものは\nほっても 出て きません。"
  },
  {
   "kind": "line",
   "scene": "end",
   "speaker": "N",
   "start": 241.426,
   "end": 245.095,
   "sub": "うめて、まって、そだてる ものです。"
  },
  {
   "kind": "hold",
   "scene": "end",
   "start": 247.095,
   "end": 252.095,
   "sub": null
  }
